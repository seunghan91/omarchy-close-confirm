# Copy to ~/.config/omarchy-close-confirm.conf and change what you need.
# Changes apply on the next keypress; no reload needed.

# Window classes to treat as terminals (see `hyprctl activewindow`).
TERMINALS="foot Alacritty"

# busy   = ask only while a program runs in the foreground (default)
# always = ask every time a terminal is closed
ASK="busy"

WIDTH=380

# The text follows your Omarchy language (Setup > Language), then $LANG.
# Pin a language from i18n.json instead:
# LANGUAGE_CODE="ko"

# Or write your own text. Empty means "use the translation".
# PROMPT="Close this terminal?"
# PROMPT_RUNNING="%1 is still running. Close?"   # %1 = program name
# CANCEL="Cancel"
# CLOSE="Close"
